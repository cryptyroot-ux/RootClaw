# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=rootclaw
ROOTCLAW_BIND_ADDRESS=127.0.0.1
ROOTCLAW_HTTP_PORT=8080
# Leave empty to use http://localhost:${ROOTCLAW_HTTP_PORT:-8080}.
ROOTCLAW_PUBLIC_URL=
# Leave empty to inherit ROOTCLAW_PUBLIC_URL.
ROOTCLAW_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set ROOTCLAW_PUBLIC_URL to https:// followed by the same hostname.
# Requires ROOTCLAW_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
ROOTCLAW_HTTPS_HOST=
ROOTCLAW_BASE_IMAGE=ghcr.io/cryptyroot-ux/rootclaw:latest
ROOTCLAW_LOCAL_IMAGE=rootclaw-local:latest
CADDY_IMAGE=caddy:2
# Optional extra npm CLIs for bots' shells (space-separated packages). Empty by
# default: RootClaw's native engine needs no external engine CLI.
ENGINES=
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
ROOTCLAW_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
ROOTCLAW_DATA_EXTERNAL=false
