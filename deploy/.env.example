# Public hostname for automatic HTTPS (must resolve to this machine).
# Pairing links (`docker compose exec rootclaw node dist-server/pair-cli.js`) point here.
DOMAIN=rootclaw.example.com

# Optional image version override. Leave unset to use the version pinned by
# docker-compose.yml; set this to the previous tag to roll back (for example,
# ROOTCLAW_IMAGE_TAG=v0.1.137).

# Optional: let people sign in with an emailed code instead of a pairing
# code. Addresses or @domain entries, comma-separated. Admins get full
# access; members get chat and approvals only.
ROOTCLAW_SIGNIN_EMAILS=
ROOTCLAW_SIGNIN_MEMBER_EMAILS=
